{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blog",
      "runtimeExecutable": "/opt/homebrew/opt/ruby/bin/bundle",
      "runtimeArgs": [
        "exec",
        "jekyll",
        "serve",
        "--port",
        "4000"
      ],
      "port": 4000
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "site-built",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8001",
        "--directory",
        "_site"
      ],
      "port": 8001
    }
  ]
}
